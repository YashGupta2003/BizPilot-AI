# MongoDB Connection
# For local MongoDB: mongodb://localhost:27017
# For MongoDB Atlas (cloud, recommended for learning): mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=bizpilot_db

# JWT Auth
JWT_SECRET_KEY=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM API (pick one or both)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# App config
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
