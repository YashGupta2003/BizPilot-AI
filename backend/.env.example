# MongoDB Connection
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=bizpilot_db

# JWT Auth (CHANGE THIS! Use: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI API Keys (optional — app works without them using fallback responses)
GROQ_API_KEY=
OPENAI_API_KEY=

# WhatsApp Payment Reminders (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# App Config
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
